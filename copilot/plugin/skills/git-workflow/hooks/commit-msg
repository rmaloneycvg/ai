#!/bin/bash
# Git hook: commit-msg
# Validates commit messages against conventional commit format.
# Installed by setup.sh as a symlink into .git/hooks/
#
# This is a thin shim that delegates to the Python validation module.

# Resolve the real location of this script (follows symlinks)
HOOK_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

# scripts/ is a sibling of hooks/ in the skill directory
SKILL_DIR="$(cd "$HOOK_DIR/.." && pwd)"
GIT_SCRIPTS_DIR="$SKILL_DIR/scripts"

if [ ! -d "$GIT_SCRIPTS_DIR" ]; then
    echo "⚠️  git-workflow scripts not found. Skipping commit-msg validation."
    echo "   Expected at: $GIT_SCRIPTS_DIR"
    exit 0
fi

# Resolve the commit message file to an absolute path before changing directories
COMMIT_MSG_FILE="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"

# Run the Python validator
cd "$GIT_SCRIPTS_DIR" || exit 0

if command -v uv &>/dev/null; then
    uv run python -m src.lib.conventional validate-file "$COMMIT_MSG_FILE"
else
    python -m src.lib.conventional validate-file "$COMMIT_MSG_FILE"
fi
