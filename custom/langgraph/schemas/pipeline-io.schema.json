{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PipelineIO",
  "description": "Inter-agent communication contract. Every sub-agent receives PipelineInput and returns PipelineOutput.",
  "definitions": {
    "PipelineInput": {
      "type": "object",
      "required": ["task_type", "input"],
      "properties": {
        "task_type": {
          "type": "string",
          "enum": ["skill_create", "agent_create", "steering_write", "tool_build", "model_profile", "rag_manage"],
          "description": "Domain-specific task classification"
        },
        "input": {
          "type": "object",
          "required": ["description"],
          "properties": {
            "description": {
              "type": "string",
              "description": "Human-readable description of what needs to be done"
            },
            "target_files": {
              "type": "array",
              "items": {"type": "string"},
              "description": "File or directory paths this task targets"
            },
            "constraints": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Hard requirements the sub-agent must follow"
            },
            "upstream_decisions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["from_agent", "decisions"],
                "properties": {
                  "from_agent": {"type": "string"},
                  "decisions": {
                    "type": "array",
                    "items": {"type": "string"}
                  }
                }
              },
              "description": "Decisions from earlier pipeline stages"
            }
          }
        }
      }
    },
    "PipelineOutput": {
      "type": "object",
      "required": ["task_type", "output"],
      "properties": {
        "task_type": {
          "type": "string"
        },
        "output": {
          "type": "object",
          "required": ["status", "files_created", "files_modified", "decisions_made", "errors", "error_count", "retry_context"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["success", "partial", "failed"]
            },
            "files_created": {
              "type": "array",
              "items": {"type": "string"}
            },
            "files_modified": {
              "type": "array",
              "items": {"type": "string"}
            },
            "decisions_made": {
              "type": "array",
              "items": {"type": "string"}
            },
            "follow_up_suggestions": {
              "type": "array",
              "items": {"type": "string"}
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type", "message", "attempt"],
                "properties": {
                  "type": {"type": "string"},
                  "message": {"type": "string"},
                  "file": {"type": "string"},
                  "line": {"type": "integer"},
                  "attempt": {"type": "integer"}
                }
              }
            },
            "error_count": {
              "type": "integer",
              "minimum": 0
            },
            "retry_context": {
              "type": "object",
              "required": ["attempts_made", "max_attempts", "strategies_tried", "should_escalate"],
              "properties": {
                "attempts_made": {"type": "integer", "minimum": 0},
                "max_attempts": {"type": "integer", "minimum": 1},
                "strategies_tried": {
                  "type": "array",
                  "items": {"type": "string"}
                },
                "should_escalate": {"type": "boolean"}
              }
            }
          }
        }
      }
    }
  }
}
