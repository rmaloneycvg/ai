{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentConfig",
  "description": "Schema for a Kiro-format agent JSON configuration.",
  "type": "object",
  "required": ["name", "description", "prompt", "tools", "allowedTools"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "kebab-case agent identifier"
    },
    "description": {
      "type": "string",
      "description": "When to route to this agent (intent trigger)"
    },
    "prompt": {
      "type": "string",
      "description": "System prompt defining behavior and constraints"
    },
    "mcpServers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["command", "args"],
        "properties": {
          "command": {"type": "string"},
          "args": {"type": "array", "items": {"type": "string"}},
          "timeout": {"type": "integer"}
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {"type": "string"},
      "description": "All tools the agent CAN use"
    },
    "allowedTools": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Tools auto-approved without user confirmation"
    },
    "toolsSettings": {
      "type": "object",
      "properties": {
        "shell": {
          "type": "object",
          "properties": {
            "allowedCommands": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {"type": "string"},
      "description": "skill:// and file:// URIs loaded at startup"
    },
    "hooks": {
      "type": "object",
      "properties": {
        "agentSpawn": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["command"],
            "properties": {
              "command": {"type": "string"},
              "timeout_ms": {"type": "integer"}
            }
          }
        }
      }
    }
  }
}
