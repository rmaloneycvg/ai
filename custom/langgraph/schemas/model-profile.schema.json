{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModelProfile",
  "description": "Empirical calibration profile for a specific LLM model. Generated by the profiler, editable by humans.",
  "type": "object",
  "required": ["model_name", "provider", "context_window", "scores", "strategies", "calibrated_at", "version"],
  "properties": {
    "model_name": {
      "type": "string",
      "description": "Model identifier (e.g., llama3.1:8b, gpt-4o)"
    },
    "provider": {
      "type": "string",
      "enum": ["ollama", "openai", "anthropic", "vllm", "llamacpp"],
      "description": "Provider backend"
    },
    "context_window": {
      "type": "integer",
      "minimum": 1024,
      "description": "Effective context window in tokens"
    },
    "scores": {
      "type": "object",
      "description": "Capability scores from calibration (0-10 scale)",
      "required": ["reasoning", "instruction_following", "structured_output", "tool_calling", "creativity"],
      "properties": {
        "reasoning": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Multi-step logical reasoning quality"
        },
        "instruction_following": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Ability to follow complex instructions precisely"
        },
        "structured_output": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Quality of JSON/XML/structured format output"
        },
        "tool_calling": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Correct tool selection and parameter formatting"
        },
        "creativity": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Quality of creative/rewrite tasks"
        }
      }
    },
    "strategies": {
      "type": "object",
      "description": "Prompt strategy decisions derived from scores",
      "required": ["cot_needed", "json_mode", "xml_preferred", "max_tools_per_call", "prompt_length_sweet_spot"],
      "properties": {
        "cot_needed": {
          "type": "boolean",
          "description": "Whether to add explicit chain-of-thought scaffolding"
        },
        "json_mode": {
          "type": "boolean",
          "description": "Whether to use JSON output mode"
        },
        "xml_preferred": {
          "type": "boolean",
          "description": "Whether XML structure performs better than JSON for this model"
        },
        "max_tools_per_call": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "description": "Maximum tool schemas to include per LLM call"
        },
        "prompt_length_sweet_spot": {
          "type": "integer",
          "minimum": 100,
          "maximum": 200000,
          "description": "Optimal prompt length in tokens where model performs best"
        },
        "examples_needed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "Number of few-shot examples to include"
        },
        "reasoning_scaffolding": {
          "type": "string",
          "enum": ["none", "light", "full"],
          "description": "Level of reasoning scaffolding to inject"
        }
      }
    },
    "calibrated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp of last calibration"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Profile schema version for migration"
    },
    "notes": {
      "type": "string",
      "description": "Human-editable notes about model quirks or overrides"
    }
  }
}
