# Integration test environment — docker-compose services on non-default ports
# Source this or pass to pytest: env $(cat .env.test | xargs) uv run pytest ...

# Postgres (port 5433 to avoid collision with local postgres)
PGHOST=localhost
PGPORT=5433
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=langgraph_test

# Prometheus (port 9091 to avoid collision)
PROMETHEUS_URL=http://localhost:9091
PROMETHEUS_AUTH_TOKEN=

# Jaeger (port 16687 to avoid collision)
JAEGER_URL=http://localhost:16687
JAEGER_AUTH_TOKEN=

# Grafana (port 3001 to avoid collision)
GRAFANA_URL=http://localhost:3001
GRAFANA_API_KEY=
GRAFANA_ORG_ID=

# Workspace root for path safety (tests run from project root)
WORKSPACE_ROOT=.
