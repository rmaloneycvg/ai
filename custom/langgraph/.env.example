# LLM Provider Configuration
# Set the default provider and model (overridable via CLI --provider/--model)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b

# Ollama (local models)
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI (external)
OPENAI_API_KEY=

# Anthropic / Claude (external)
ANTHROPIC_API_KEY=

# vLLM (local, OpenAI-compatible)
VLLM_BASE_URL=http://localhost:8000/v1

# llama.cpp (local, direct model file)
LLAMACPP_MODEL_PATH=

# Tool connections (mirrors Kiro MCP env vars)
# Postgres
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=postgres

# Prometheus
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_AUTH_TOKEN=

# Jaeger
JAEGER_URL=http://localhost:16686
JAEGER_AUTH_TOKEN=

# Grafana
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=
GRAFANA_ORG_ID=

# Jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Linear
LINEAR_API_KEY=

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8765
