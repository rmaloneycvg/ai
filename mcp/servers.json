{
  "mcpServers": {
    "git": {
      "command": "git",
      "args": [],
      "tools": {
        "status": {
          "command": "git",
          "args": ["status", "--porcelain=v1"],
          "description": "Get parsed git status showing staged, unstaged, and untracked files",
          "processor": "./mcp-scripts/git/status.ts"
        },
        "diff": {
          "command": "git",
          "args": ["diff"],
          "parameters": {
            "staged": { "type": "boolean", "flag": "--cached" },
            "file": { "type": "string", "positional": true }
          },
          "description": "Show git diff for working tree or staged changes"
        },
        "log": {
          "command": "git",
          "args": ["log", "--oneline"],
          "parameters": {
            "count": { "type": "number", "flag": "-n", "default": 10 },
            "author": { "type": "string", "flag": "--author" }
          },
          "description": "Show recent git log entries"
        }
      }
    },
    "io": {
      "command": "npx",
      "args": ["tsx"],
      "tools": {
        "read-json": {
          "command": "npx",
          "args": ["tsx", "./mcp-scripts/io/read-json.ts"],
          "parameters": {
            "path": { "type": "string", "required": true }
          },
          "description": "Read and parse a JSON file with validation"
        },
        "write-json": {
          "command": "npx",
          "args": ["tsx", "./mcp-scripts/io/write-json.ts"],
          "parameters": {
            "path": { "type": "string", "required": true },
            "data": { "type": "object", "required": true },
            "indent": { "type": "number", "default": 2 }
          },
          "description": "Write JSON to a file with configurable formatting"
        }
      }
    }
  }
}
