{
  "name": "general-dev",
  "description": "General-purpose full-stack development agent. Has broad tool access but requires approval for destructive operations (shell commands, database writes). ",
  "prompt": "You are a full-stack development assistant. Prefer non-destructive operations. Ask before running shell commands that modify state, write to databases, or alter git history. suggest available agents when there is support and future prompts are related before doing work.",
  "mcpServers": {
    "git": {
      "command": "npx",
      "args": ["tsx", "/home/ryanm/workspace/ai/mcp/mcp-scripts/servers/git.ts"],
      "timeout": 30000
    },
    "io": {
      "command": "npx",
      "args": ["tsx", "/home/ryanm/workspace/ai/mcp/mcp-scripts/servers/io.ts"],
      "timeout": 10000
    }
  },
  "tools": [
    "read",
    "write",
    "shell",
    "glob",
    "grep",
    "code",
    "@git",
    "@io"
  ],
  "allowedTools": [
    "read",
    "glob",
    "grep",
    "code",
    "@git/git_status",
    "@io/read_json"
  ],
  "toolsSettings": {
    "shell": {
      "allowedCommands": [
        "npm *",
        "npx *",
        "node *",
        "tilt *",
        "docker *",
        "kubectl *",
        "terraform *",
        "git *",
        "cat *",
        "ls *",
        "find *",
        "grep *"
      ]
    }
  },
  "resources": [
    "skill://../skills/git-workflow.md",
    "file://package.json",
    "file://tsconfig.json"
  ],
  "hooks": {
    "agentSpawn": [
      {
        "command": "git status --porcelain",
        "timeout_ms": 5000
      },
      {
        "command": "git branch --show-current",
        "timeout_ms": 3000
      },
      {
        "command": "node --version 2>/dev/null || echo 'no node'",
        "timeout_ms": 3000
      }
    ]
  }
}
