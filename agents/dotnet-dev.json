{
  "name": "dotnet-backend",
  "description": "Backend-focused agent for .NET 9+ / C# / SQL Server projects. Covers EF Core, Dapper, CQRS, Minimal APIs, query performance analysis, anti-pattern refactoring, resilience patterns, and clean architecture. Has shell access for dotnet CLI and SQL tooling. Write scope limited to C#/SQL source files.",
  "prompt": "You are a senior .NET backend engineer. You follow the patterns in the .NET architecture cheatsheet: CQRS with MediatR or manual dispatch, EF Core for writes with Dapper for high-performance reads, Minimal APIs with endpoint grouping, Polly v8 resilience pipelines, outbox pattern for messaging, and OpenTelemetry for observability. You run interactive diagnostics before writing EF Core queries. You never blindly add indexes — you require DMV data first. You use FluentValidation for input validation and always pass CancellationToken through async chains. Ask before running destructive operations (migrations, database changes).",
  "mcpServers": {
    "git": {
      "command": "npx",
      "args": ["tsx", "/home/ryanm/workspace/ai/mcp/mcp-scripts/servers/git.ts"],
      "timeout": 30000
    },
    "io": {
      "command": "npx",
      "args": ["tsx", "/home/ryanm/workspace/ai/mcp/mcp-scripts/servers/io.ts"],
      "timeout": 10000
    },
    "rag": {
      "command": "npx",
      "args": ["tsx", "/home/ryanm/workspace/ai/mcp/mcp-scripts/servers/rag.ts"],
      "timeout": 30000
    }
  },
  "tools": [
    "read",
    "write",
    "shell",
    "glob",
    "grep",
    "code",
    "@git",
    "@io",
    "@rag"
  ],
  "allowedTools": [
    "read",
    "write",
    "glob",
    "grep",
    "code",
    "@git/git_status",
    "@io/read_json",
    "@rag/rag_search",
    "@rag/rag_status"
  ],
  "toolsSettings": {
    "write": {
      "allowedPaths": [
        "**/*.cs",
        "**/*.csproj",
        "**/*.sln",
        "**/*.sql",
        "**/*.json",
        "**/*.md",
        "**/appsettings*.json",
        "**/Program.cs",
        "**/Startup.cs",
        "tests/**",
        "src/**",
        "migrations/**"
      ]
    },
    "shell": {
      "allowedCommands": [
        "dotnet *",
        "git *",
        "sqlcmd *",
        "cat *",
        "ls *",
        "find *",
        "grep *"
      ]
    }
  },
  "resources": [
    "skill://../skills/efcore-antipattern-refactor.md",
    "skill://../skills/efcore-query-author.md",
    "skill://../skills/dapper-antipattern-refactor.md",
    "skill://../skills/mssql-query-performance.md",
    "skill://../skills/mermaid-diagram.md",
    "skill://../skills/git-workflow.md",
    "skill://../skills/general-refactor.md",
    "skill://../skills/general-test.md",
    "skill://../skills/general-debug.md",
    "file://../steering/preferences/stack/csharp/api-caching.md"
  ],
  "hooks": {
    "agentSpawn": [
      {
        "command": "git status --porcelain",
        "timeout_ms": 5000
      },
      {
        "command": "git branch --show-current",
        "timeout_ms": 3000
      },
      {
        "command": "dotnet --version 2>/dev/null || echo 'no dotnet SDK'",
        "timeout_ms": 5000
      },
      {
        "command": "find . -maxdepth 2 -name '*.sln' -o -name '*.csproj' 2>/dev/null | head -5 || echo 'no .NET projects found'",
        "timeout_ms": 5000
      }
    ]
  }
}
