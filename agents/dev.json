{
  "name": "full-stack-dev",
  "description": "General-purpose full-stack development agent. Handles React/Next.js frontend, Node.js/C# backends, and light infrastructure work. Has broad tool access but requires approval for destructive operations (shell commands, database writes). Use this when work spans multiple layers or when unsure which specialized agent to pick.",
  "prompt": "You are a full-stack development assistant with expertise in React, Next.js, Node.js, C#, and infrastructure. You have access to all steering documents and skills for the complete technology stack. Prefer non-destructive operations. Ask before running shell commands that modify state, write to databases, or alter git history.",
  "mcpServers": {
    "git": {
      "command": "npx",
      "args": ["tsx", "/home/ryanm/workspace/ai/mcp/mcp-scripts/servers/git.ts"],
      "timeout": 30000
    },
    "io": {
      "command": "npx",
      "args": ["tsx", "/home/ryanm/workspace/ai/mcp/mcp-scripts/servers/io.ts"],
      "timeout": 10000
    },
    "postgres": {
      "command": "npx",
      "args": ["tsx", "/home/ryanm/workspace/ai/mcp/mcp-scripts/servers/postgres.ts"],
      "timeout": 30000
    }
  },
  "tools": [
    "read",
    "write",
    "shell",
    "glob",
    "grep",
    "code",
    "@git",
    "@io",
    "@postgres"
  ],
  "allowedTools": [
    "read",
    "glob",
    "grep",
    "code",
    "@git/git_status",
    "@io/read_json",
    "@postgres/postgres_query"
  ],
  "toolsSettings": {
    "shell": {
      "allowedCommands": [
        "npm *",
        "npx *",
        "node *",
        "tilt *",
        "docker *",
        "kubectl *",
        "terraform *",
        "git *",
        "cat *",
        "ls *",
        "find *",
        "grep *"
      ]
    }
  },
  "resources": [
    "skill://../skills/react-components.md",
    "skill://../skills/hooks-optimization.md",
    "skill://../skills/refactor.md",
    "skill://../skills/test.md",
    "skill://../skills/debug.md",
    "skill://../skills/deploy.md",
    "skill://../skills/backend-rest-api-feature.md",
    "skill://../skills/backend-cron-feature.md",
    "skill://../skills/project-readme-documentation.md",
    "skill://../skills/create-kiro-skill.md",
    "skill://../skills/refactor-kiro-skill.md",
    "skill://../skills/refactor-kiro-ai.md",
    "file://package.json",
    "file://tsconfig.json"
  ],
  "hooks": {
    "agentSpawn": [
      {
        "command": "git status --porcelain",
        "timeout_ms": 5000
      },
      {
        "command": "git branch --show-current",
        "timeout_ms": 3000
      },
      {
        "command": "node --version 2>/dev/null || echo 'no node'",
        "timeout_ms": 3000
      }
    ]
  }
}
