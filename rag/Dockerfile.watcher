FROM python:3.12-slim

WORKDIR /app

# Install Python dependencies (no OpenAI — uses Ollama via HTTP)
RUN pip install --no-cache-dir \
    psycopg[binary]>=3.2.0 \
    pgvector>=0.3.0 \
    httpx>=0.27.0

# Copy application code
COPY chunker.py embedder.py ingest.py ./

# Watch mode: poll rag_steering for changes
CMD ["python", "ingest.py", "--watch"]
