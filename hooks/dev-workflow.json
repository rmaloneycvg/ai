{
  "version": "v1",
  "hooks": [
    {
      "name": "agentSpawn-0",
      "trigger": "SessionStart",
      "action": {
        "type": "command",
        "command": "git status --porcelain"
      },
      "timeout": 5
    },
    {
      "name": "agentSpawn-1",
      "trigger": "SessionStart",
      "action": {
        "type": "command",
        "command": "git branch --show-current"
      },
      "timeout": 3
    },
    {
      "name": "discover-docker",
      "trigger": "SessionStart",
      "action": {
        "type": "command",
        "command": "docker ps --format '{{.Names}} ({{.Ports}})' || echo 'Docker is not running'"
      },
      "timeout": 5
    },
    {
      "name": "format-on-save",
      "trigger": "PostFileSave",
      "filters": {
        "path": "\\.(ts|tsx|js|jsx|json)$"
      },
      "action": {
        "type": "command",
        "command": "npx prettier --write \"$KIRO_FILE_PATH\""
      },
      "timeout": 10
    },
    {
      "name": "scaffold-tests-on-create",
      "trigger": "PostFileCreate",
      "filters": {
        "path": "^src/.*\\.(ts|js)$",
        "exclude": "\\.test\\.(ts|js)$"
      },
      "action": {
        "type": "prompt",
        "prompt": "I just created $KIRO_FILE_PATH. Please generate a corresponding unit test file with standard boilerplate and save it next to the original file."
      }
    },
    {
      "name": "guard-destructive-commands",
      "trigger": "PreToolUse",
      "filters": {
        "tool": "terminal",
        "command": "(git push.*--force|rm -rf .*|drop table)"
      },
      "action": {
        "type": "command",
        "command": "echo '[Kiro Guardrail] Destructive command blocked. Run manually if you are sure.' && exit 1"
      }
    }
  ]
}